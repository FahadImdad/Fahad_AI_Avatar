# SECURITY WARNING: Never commit your actual API keys to version control
# Copy this file to .env.local and add your real keys there

# ========================================
# REQUIRED API KEYS
# ========================================

# Google Gemini API Configuration (For vision chat when camera is on - FREE with generous quota!)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Tavily Search API Configuration
# Used to fetch Fahad's personality from fahadimdad.com
TAVILY_API_KEY=your_tavily_api_key_here

# ========================================
# OPTIONAL API KEYS
# ========================================

# ElevenLabs API Configuration (For text-to-speech)
# - Falls back to Web Speech API if not configured or if it fails
# - Get your key at: https://elevenlabs.io/
# - IMPORTANT: Do NOT use NEXT_PUBLIC_ prefix (these are server-side only for security)
# ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# ELEVENLABS_VOICE_ID=your_voice_id_here

# ========================================
# OPTIONAL API KEYS (Not used by default)
# ========================================

# Groq API Configuration (Alternative for text-only chat - FREE and FAST!)
# Get your free key at: https://console.groq.com
# GROQ_API_KEY=your_groq_api_key_here

# OpenAI API Configuration (Alternative for vision chat - GPT-4o-mini)
# Get your key at: https://platform.openai.com/api-keys
# OPENAI_API_KEY=your_openai_api_key_here
